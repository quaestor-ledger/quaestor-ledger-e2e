# Target under test. When unset, the suites boot the bundled fixture site on an
# ephemeral localhost port. Point this at a real Quaestor surface to test it:
#   E2E_BASE_URL=https://quaestor-ledger.github.io
#   E2E_BASE_URL=http://127.0.0.1:4321      # local Astro preview of the site repo
#   E2E_BASE_URL=http://127.0.0.1:8080      # local quaestor-web-server.rs
# E2E_BASE_URL=

# Selenium Grid endpoint (RemoteWebDriver). When set, the Selenium suite drives
# a remote Grid instead of a local chromedriver.
#   http://localhost:4444                    # local `npm run selenium:up`
#   http://localhost:4444                    # cluster Grid via `npm run selenium:cluster`
# SELENIUM_REMOTE_URL=http://localhost:4444

# Hostname the remote browser uses to reach a localhost fixture. A Grid running
# in Docker/k8s cannot resolve the host's `localhost`, so localhost base URLs are
# rewritten to this host (Docker Desktop provides host.docker.internal).
# SELENIUM_BROWSER_HOST=host.docker.internal

# Run browsers headed for local debugging (default: headless).
# E2E_HEADED=1
