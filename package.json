{
  "name": "@quaestor-ledger/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-driver end-to-end tests for Quaestor Ledger web surfaces, running one shared scenario set across Playwright, Puppeteer, and Selenium.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/contract.test.mjs tests/browser/playwright/*.test.mjs tests/browser/puppeteer/*.test.mjs tests/browser/selenium/*.test.mjs",
    "test:contract": "node --test tests/contract.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/playwright/*.test.mjs tests/browser/puppeteer/*.test.mjs tests/browser/selenium/*.test.mjs",
    "test:playwright": "node --test tests/browser/playwright/*.test.mjs",
    "test:puppeteer": "node --test tests/browser/puppeteer/*.test.mjs",
    "test:selenium": "node --test tests/browser/selenium/*.test.mjs",
    "test:firefox": "node --test tests/browser/playwright/firefox.test.mjs",
    "test:webkit": "node --test tests/browser/playwright/webkit.test.mjs",
    "fixture": "node scripts/serve-fixture.mjs",
    "browsers:install": "playwright install chromium firefox webkit",
    "selenium:up": "docker compose -f docker-compose.selenium.yml up -d --wait",
    "selenium:down": "docker compose -f docker-compose.selenium.yml down",
    "selenium:cluster": "bash scripts/cluster-selenium.sh",
    "postinstall": "playwright install chromium firefox webkit || true"
  },
  "dependencies": {
    "playwright": "1.56.0",
    "puppeteer": "^24.22.3",
    "selenium-webdriver": "^4.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0"
  }
}
